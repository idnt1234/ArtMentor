# Copy to .env and keep it private. Never expose either key to the frontend.
AI_PROVIDER=gptsapi

# WildAI / GPTsAPI (OpenAI-compatible Chat Completions + vision)
GPTSAPI_KEY=
GPTSAPI_BASE_URL=https://api.gptsapi.net/v1
GPTSAPI_MODEL=gpt-5.6-terra

# Optional official OpenAI provider. Set AI_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
ALLOW_DEMO_FALLBACK=true

# Docker Compose uses PostgreSQL and MinIO. Local Python defaults to SQLite + disk.
DATABASE_URL=sqlite:///./data/artmentor.sqlite3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=artmentor
MINIO_SECRET_KEY=change-this-password
MINIO_BUCKET=artmentor

# Supabase Storage uses its S3-compatible endpoint. Keep these empty for local disk.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=artmentor-artworks
S3_REGION=us-east-1
S3_AUTO_CREATE_BUCKET=false

FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=15
ANALYSIS_MAX_SIDE=1600
SESSION_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=false
# Optional but strongly recommended for a public demo with a shared AI budget.
DEMO_ACCESS_CODE=
AI_RATE_LIMIT_PER_HOUR=20
UPLOAD_RATE_LIMIT_PER_HOUR=10
MAX_CONCURRENT_AI_REQUESTS=2
