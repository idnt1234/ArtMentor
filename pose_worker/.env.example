# Copy this file to pose_worker/.env on the GPU server. Never commit the copy.
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSE_WORKER_API_TOKEN=replace-with-a-long-random-value
PORT=6006
POSE_DEVICE=auto
POSE_REQUIRE_CUDA=true
POSE_MAX_IMAGE_MB=10
ARTMENTOR_POSE_HOME=/root/autodl-tmp/ArtMentorPose
